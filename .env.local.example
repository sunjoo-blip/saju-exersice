# === 운동팔자 환경변수 ===
# 실제 값은 .env.local 에 넣고 절대 커밋하지 않습니다. (외부 API 키는 서버 환경변수로만 관리)

# OpenAI
OPENAI_API_KEY=sk-...
# 사용할 모델 (미설정 시 gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# 접속 코드 게이트 (OpenAI 비용 보호).
# - 쉼표로 여러 개 지정 가능. 지인별로 다른 코드를 주면 추후 추적/회수가 쉬움.
# - 비워 두면 게이트가 꺼짐(로컬 개발용). 배포 시 반드시 설정하세요.
ACCESS_CODES=change-me-1,change-me-2

# 하루 1회 레이트리밋 (OpenAI 토큰 비용 보호) — Redis(ioredis / redis:// TCP)
# - bizmsg-generator 가 쓰는 것과 동일한 REDIS_URL 을 그대로 재사용 가능.
#   (키는 rl:analyze:* 로 네임스페이스가 있어 기존 데이터와 충돌하지 않음)
# - 비어 있으면 레이트리밋이 꺼짐(로컬 개발용). 배포 시 반드시 설정하세요.
# - Redis 장애 시에는 '허용'으로 열리므로(fail-open), 비용 1차 방어선은 ACCESS_CODES 입니다.
REDIS_URL=redis://...
# 한도(선택) — 미설정 시 브라우저 1회/일, IP 5회/일.
#   IP는 모바일/사내망 공유를 고려해 넉넉히 둡니다(오탐 방지 백스톱).
RATE_LIMIT_PER_BROWSER=1
RATE_LIMIT_PER_IP=5
# IP 제한 면제 코드(쉼표로 여러 개) — 이 코드로 들어온 사람은 IP 백스톱을 건너뜀.
#   같은 와이파이(행사·사무실)에서 여러 명이 각자 브라우저당 하루 1회 이용 가능.
#   주의: 반드시 ACCESS_CODES 에도 포함돼 있어야 입장할 수 있습니다.
IP_EXEMPT_CODES=obud2026

# 공유 링크 / OG 메타태그용 서비스 공개 URL (배포 도메인)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 장소 탐색 CTA가 연결될 오붓 링크 (F7). 미설정 시 기본 placeholder 사용.
NEXT_PUBLIC_OBUD_URL=https://www.obud.co
